[
  {
    "at": 0.21,
    "end": 2.42,
    "text": "大野で、ビール\n作りました。"
  },
  {
    "at": 3.23,
    "end": 5.65,
    "text": "きっかけは、\nある日ふと思ったこと。"
  },
  {
    "at": 6.09,
    "end": 7.43,
    "text": "大野って、\n田舎なんですよ。"
  },
  {
    "at": 7.74,
    "end": 9.09,
    "text": "若い子が、\nどんどん出ていって。"
  },
  {
    "at": 9.75,
    "end": 12.23,
    "text": "お店も、\nひとつ、また ひとつ、\n消えていく。"
  },
  {
    "at": 12.82,
    "end": 15.46,
    "text": "でも大野には\n名水百選の水がある。"
  },
  {
    "at": 16.1,
    "end": 17.36,
    "text": "無農薬の、お米。"
  },
  {
    "at": 17.98,
    "end": 18.97,
    "text": "荒島岳。"
  },
  {
    "at": 19.53,
    "end": 21.58,
    "text": "なのに、なぜか、\nビールがなかった。"
  },
  {
    "at": 22.15,
    "end": 23.07,
    "text": "なんで、ないんやろ。"
  },
  {
    "at": 23.67,
    "end": 25.42,
    "text": "その日から、\n動きはじめた。"
  },
  {
    "at": 25.91,
    "end": 28.34,
    "text": "140年続く\n醤油屋さんの井戸水。"
  },
  {
    "at": 28.91,
    "end": 30.51,
    "text": "福井の\n醸造家さんの技。"
  },
  {
    "at": 31.14,
    "end": 33.54,
    "text": "「野」の字が入った、\n一本の缶。"
  },
  {
    "at": 34.11,
    "end": 38.44,
    "text": "8月13日、\n花火大会の夜に、\n打ち上げます。"
  },
  {
    "at": 38.79,
    "end": 40.31,
    "text": "でも、そもそも\nこの話。"
  },
  {
    "at": 40.61,
    "end": 43.89,
    "text": "なんで居酒屋の大将が、\nビールを作ることに?"
  },
  {
    "at": 44.37,
    "end": 45.56,
    "text": "続きは、次回。"
  }
]