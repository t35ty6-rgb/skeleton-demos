    "text": "きっかけは、",
    "mode": "v-left"
  },
  {
    "at": 4,
    "end": 4.75,
    "text": "ある日ふと",
    "mode": "v-right"
  },
  {
    "at": 4.75,
    "end": 5.65,
    "text": "思ったこと。",
    "mode": "v-left"
  },
  {
    "at": 6.09,
    "end": 6.75,
    "text": "大野って、",
    "mode": "v-right"
  },
  {
    "at": 6.75,
    "end": 7.43,
    "text": "田舎です。",
    "mode": "v-left"
  },
  {
    "at": 7.74,
    "end": 8.42,
    "text": "若い子が、",
    "mode": "v-right"
  },
  {
    "at": 8.42,
    "end": 9.09,
    "text": "出ていく。",
    "mode": "v-left"
  },
  {
    "at": 9.75,
    "end": 10.6,
    "text": "お店も、",
    "mode": "v-right"
  },
  {
    "at": 10.6,
    "end": 11.4,
    "text": "ひとつ、また",
    "mode": "v-left"
  },
  {
    "at": 11.4,
    "end": 12.23,
    "text": "消えていく。",
    "mode": "v-right"
  },
  {
    "at": 12.82,
    "end": 13.75,
    "text": "でも大野には、",
    "mode": "v-left"
  },
  {
    "at": 13.75,
    "end": 14.55,
    "text": "名水百選の、",
    "mode": "v-right"
  },
  {
    "at": 14.55,
    "end": 15.46,
    "text": "水がある。",
    "mode": "v-left"
  },
  {
    "at": 16.1,
    "end": 16.75,
    "text": "無農薬の、",
    "mode": "v-right"
  },
  {
    "at": 16.75,
