    "text": "お米。",
    "mode": "v-center-hi"
  },
  {
    "at": 17.98,
    "end": 18.97,
    "text": "荒島岳。",
    "mode": "v-center-hi"
  },
  {
    "at": 19.53,
    "end": 20.5,
    "text": "なのになぜか、",
    "mode": "v-right"
  },
  {
    "at": 20.5,
    "end": 21.58,
    "text": "ビールがなかった。",
    "mode": "v-left"
  },
  {
    "at": 22.15,
    "end": 23.07,
    "text": "なんで、\nないんやろ。",
    "mode": "emphasis-red"
  },
  {
    "at": 23.67,
    "end": 24.55,
    "text": "その日から、",
    "mode": "v-right"
  },
  {
    "at": 24.55,
    "end": 25.42,
    "text": "動きはじめた。",
    "mode": "v-left"
  },
  {
    "at": 25.91,
    "end": 26.75,
    "text": "140年、",
    "mode": "v-right"
  },
  {
    "at": 26.75,
    "end": 27.55,
    "text": "醤油屋の、",
    "mode": "v-left"
  },
  {
    "at": 27.55,
    "end": 28.34,
    "text": "井戸水。",
    "mode": "v-right"
  },
  {
    "at": 28.91,
    "end": 29.75,
    "text": "福井の、",
    "mode": "v-left"
  },
  {
    "at": 29.75,
    "end": 30.51,
    "text": "醸造家の技。",
    "mode": "v-right"
  },
  {
    "at": 31.14,
    "end": 32.35,
    "text": "「野」の字が。",
    "mode": "v-left"
  },
  {
    "at": 32.35,
    "end": 33.54,
    "text": "一本の缶。",
    "mode": "v-right"
  },
  {
    "at": 34.11,
    "end": 35.55,
    "text": "8月13日。",
    "mode": "v-center-hi"
  },
  {
    "at": 35.55,
    "end": 36.95,
    "text": "花火大会の、",
    "mode": "v-left"
  },
  {
    "at": 36.95,
    "end": 38.44,
    "text": "打ち上げます。",
    "mode": "v-right"
  },
  {
    "at": 38.79,
    "end": 40.31,
    "text": "この話、\nそもそも?",
    "mode": "emphasis-red"
  },
  {
    "at": 40.61,
    "end": 41.55,
    "text": "なんで、",
    "mode": "v-right"
  },
  {
    "at": 41.55,
    "end": 42.85,
    "text": "居酒屋の大将が、",
    "mode": "v-left"
  },
  {
    "at": 42.85,
    "end": 43.89,
    "text": "ビールを?",
    "mode": "v-right"
  },
  {
    "at": 44.37,
