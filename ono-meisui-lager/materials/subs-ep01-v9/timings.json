[
  {
    "at": 0,
    "end": 3,
    "text": "大野で、ビール\n作りました。",
    "vertical": false
  },
  {
    "at": 3,
    "end": 6,
    "text": "きっかけは、\nある日ふと\n思ったこと。",
    "vertical": false
  },
  {
    "at": 6,
    "end": 8,
    "text": "大野って、\n田舎なんですよ。",
    "vertical": false
  },
  {
    "at": 8,
    "end": 10,
    "text": "若い子が\nどんどん\n出ていって、",
    "vertical": false
  },
  {
    "at": 10,
    "end": 13,
    "text": "お店も、\nひとつ、また\nひとつ、消えていく。",
    "vertical": false
  },
  {
    "at": 13,
    "end": 16,
    "text": "でも大野には\n名水百選の水がある。",
    "vertical": false
  },
  {
    "at": 16,
    "end": 18,
    "text": "無農薬の\nお米がある。",
    "vertical": false
  },
  {
    "at": 18,
    "end": 20,
    "text": "荒島岳がある。",
    "vertical": true
  },
  {
    "at": 20,
    "end": 22,
    "text": "なのに、なぜか、\nビールがなかった。",
    "vertical": false
  },
  {
    "at": 22,
    "end": 24,
    "text": "なんで、\nないんやろ。",
    "vertical": true
  },
  {
    "at": 24,
    "end": 26,
    "text": "その日から、\n動きはじめた。",
    "vertical": false
  },
  {
    "at": 26,
    "end": 29,
    "text": "140年続く\n醤油屋さんの\n井戸水。",
    "vertical": false
  },
  {
    "at": 29,
    "end": 31,
    "text": "福井の\n醸造家さんの技。",
    "vertical": false
  },
  {
    "at": 31,
    "end": 34,
    "text": "「野」の字が入った、\n一本の缶。",
    "vertical": false
  },
  {
    "at": 34,
    "end": 39,
    "text": "8月13日、\n花火大会の夜に\n打ち上げます。",
    "vertical": false
  },
  {
    "at": 39,
    "end": 41,
    "text": "でも、そもそも\nこの話。",
    "vertical": false
  },
  {
    "at": 41,
    "end": 44,
    "text": "なんで\n居酒屋の大将が、\nビールを?",
    "vertical": false
  },
  {
    "at": 44,
    "end": 46,
    "text": "続きは、\n次回。",
    "vertical": false
  }
]