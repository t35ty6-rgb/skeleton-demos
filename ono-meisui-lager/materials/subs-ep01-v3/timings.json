[
  {
    "at": 0,
    "end": 1.99,
    "text": "大野で、あることが\n始まっています"
  },
  {
    "at": 1.99,
    "end": 4.88,
    "text": "私は、大野で\n生まれ育ちました"
  },
  {
    "at": 4.88,
    "end": 7.76,
    "text": "この街でずっと\n飲食店を営んでいます"
  },
  {
    "at": 7.76,
    "end": 9.6,
    "text": "コロナ禍が\n明けた時"
  },
  {
    "at": 9.6,
    "end": 13.04,
    "text": "周りの店が 次々と\n姿を消していました"
  },
  {
    "at": 13.04,
    "end": 17.2,
    "text": "街を歩く人も 以前より\nずっと少なくなっていました"
  },
  {
    "at": 17.2,
    "end": 19.5,
    "text": "「大野の魅力とは、\n何ですか」"
  },
  {
    "at": 19.5,
    "end": 23.26,
    "text": "そう問われた時、\n答えられませんでした"
  },
  {
    "at": 23.26,
    "end": 26.68,
    "text": "生まれ育った街なのに\n一言で 語れなかった"
  },
  {
    "at": 26.68,
    "end": 28.08,
    "text": "それが、\n悔しかった"
  },
  {
    "at": 28.08,
    "end": 34.24,
    "text": "このままでは 大野の良さが\n消えていく、そう思いました"
  },
  {
    "at": 34.24,
    "end": 35.8,
    "text": "だから、\n動きました"
  },
  {
    "at": 35.8,
    "end": 40.36,
    "text": "大野の資源を使って、\n一本のビールを作りました"
  },
  {
    "at": 40.36,
    "end": 42.65,
    "text": "名前は、\n大野名水ラガー"
  },
  {
    "at": 42.65,
    "end": 46.68,
    "text": "これから少しずつ、\n物語をお話ししていきます"
  },
  {
    "at": 46.68,
    "end": 49.13,
    "text": "8月、\n大野で発売します"
  },
  {
    "at": 49.13,
    "end": 51.33,
    "text": "どうか最後まで\nお付き合いください"
  }
]