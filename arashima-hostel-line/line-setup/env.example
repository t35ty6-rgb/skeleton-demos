# 荒島ホテル LINE 予約システム — 環境変数テンプレ
# このファイルを .env にコピーして、各値を埋めてください

# ============================================
# LINE Messaging API (オーナーが LINE Official Account Manager で取得)
# ============================================
LINE_CHANNEL_ID=2000000000
LINE_CHANNEL_SECRET=ここに32文字のシークレットを貼り付け
LINE_CHANNEL_ACCESS_TOKEN=long-livedのアクセストークンを貼り付け

# ============================================
# LIFF (Jobs が LINE Developers Console で作成)
# ============================================
LIFF_ID=2000000000-XxXxXxXx

# ============================================
# Firebase
# ============================================
FIREBASE_PROJECT_ID=arashima-hotel
FIREBASE_HOSTING_URL=https://arashima-hotel.web.app

# ============================================
# オーナー LINE userId (新規予約通知の宛先)
# オーナーが自分で公式アカウントを友だち追加して、最初の挨拶 webhook を経由して取得
# ============================================
OWNER_LINE_USER_ID=U00000000000000000000000000000000

# ============================================
# 動作環境
# ============================================
NODE_ENV=production
TZ=Asia/Tokyo
