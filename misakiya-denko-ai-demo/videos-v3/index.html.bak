<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>三崎屋電工AI — v3 世界標準リビルド</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&family=Inter+Tight:wght@400;500;600;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --black: #0b1020;
  --ink: #0f172a;
  --ink-2: #374151;
  --ink-3: #6b7280;
  --navy: #1a2547;
  --bg: #f5f7fb;
  --bg2: #edf0f7;
  --surface: #ffffff;
  --rule: #e2e6f0;
  --elec: #2563eb;
  --elec-dk: #1d4ed8;
  --elec-tint: #eff6ff;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: 'Noto Sans JP', system-ui, sans-serif;
  font-size: 14px; line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "palt" 1, "tnum" 1;
}
a { color: inherit; text-decoration: none; }

.header {
  background: linear-gradient(135deg, var(--black) 0%, var(--navy) 100%);
  color: #fff;
  padding: 60px 48px 52px;
}
.header-brand {
  font-family: 'Inter Tight', sans-serif;
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.24em; text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  margin-bottom: 20px;
}
.header-title {
  font-family: 'Zen Kaku Gothic New', 'Noto Sans JP', sans-serif;
  font-weight: 900; font-size: 52px;
  letter-spacing: -0.045em; line-height: 1.05;
  margin-bottom: 12px;
}
.header-title span { color: #7ea8ff; }
.header-sub {
  font-family: 'Noto Sans JP', sans-serif;
  font-weight: 500; font-size: 17px;
  color: rgba(255,255,255,0.6);
  margin-bottom: 28px;
  max-width: 700px;
}
.header-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.meta-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 100px;
  padding: 6px 14px;
  font-family: 'Inter Tight', sans-serif;
  font-size: 11px; font-weight: 700;
  color: rgba(255,255,255,0.72);
  letter-spacing: 0.14em; text-transform: uppercase;
}
.meta-badge.highlight { background: var(--elec); border-color: var(--elec); color: #fff; }

.content { max-width: 1080px; margin: 0 auto; padding: 44px 24px 60px; }

.video-wrap {
  background: #000;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(11, 16, 32, 0.18), 0 4px 16px rgba(11, 16, 32, 0.08);
  margin-bottom: 40px;
}
.video-wrap video {
  display: block; width: 100%; height: auto;
  aspect-ratio: 16/9; background: #000;
}

.chapters { margin-bottom: 44px; }
.ch-title-row {
  display: flex; align-items: center; gap: 14px;
  margin-bottom: 20px;
}
.ch-title {
  font-family: 'Zen Kaku Gothic New', 'Noto Sans JP', sans-serif;
  font-weight: 700; font-size: 20px;
  letter-spacing: -0.02em;
}
.ch-title::after { content: none; }
.ch-count {
  font-family: 'Inter Tight', sans-serif;
  font-size: 12px; font-weight: 700;
  color: var(--ink-3);
  letter-spacing: 0.12em; text-transform: uppercase;
}
.ch-title-row .rule { flex: 1; height: 1px; background: var(--rule); }

.ch-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 10px;
}
.ch-btn {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 16px 18px;
  background: var(--surface);
  border: 1.5px solid var(--rule);
  border-radius: 10px;
  cursor: pointer;
  transition: border-color .15s, background .15s, box-shadow .15s;
  text-align: left;
  font-family: inherit; color: inherit;
}
.ch-btn:hover {
  border-color: var(--elec);
  background: var(--elec-tint);
  box-shadow: 0 4px 14px rgba(37,99,235,0.12);
}
.ch-btn.active {
  border-color: var(--elec);
  background: var(--elec-tint);
}
.ch-num {
  font-family: 'Inter Tight', sans-serif;
  font-size: 14px; font-weight: 900;
  color: var(--elec);
  min-width: 24px;
  letter-spacing: -0.02em;
}
.ch-info { flex: 1; min-width: 0; }
.ch-name {
  font-family: 'Zen Kaku Gothic New', 'Noto Sans JP', sans-serif;
  font-weight: 700; font-size: 14px;
  color: var(--ink);
  line-height: 1.45;
  margin-bottom: 4px;
  letter-spacing: -0.01em;
}
.ch-dur {
  font-family: 'Inter Tight', sans-serif;
  font-size: 11px; font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 0.02em;
}

.about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 40px;
}
.about-card {
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 10px;
  padding: 24px 26px;
}
.about-card-h {
  font-family: 'Zen Kaku Gothic New', 'Noto Sans JP', sans-serif;
  font-weight: 700; font-size: 15px;
  color: var(--ink);
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--rule);
  letter-spacing: -0.01em;
}
.about-card ul {
  list-style: none;
  display: flex; flex-direction: column; gap: 9px;
}
.about-card li {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 13.5px; font-weight: 500;
  color: var(--ink-2); line-height: 1.55;
}
.about-card li::before {
  content: '';
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--elec); flex-shrink: 0;
  margin-top: 8px;
}

.credits {
  padding: 20px 24px;
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 10px;
  font-family: 'Inter Tight', sans-serif;
  font-size: 12px; font-weight: 500;
  color: var(--ink-3);
  line-height: 1.7;
  letter-spacing: 0.02em;
}
.credits b { font-weight: 700; color: var(--ink-2); }

.footer {
  border-top: 1px solid var(--rule);
  padding: 26px 24px;
  text-align: center;
  font-family: 'Inter Tight', sans-serif;
  font-size: 11px; font-weight: 700;
  color: var(--ink-3);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-top: 20px;
}

@media (max-width: 720px) {
  .header { padding: 32px 20px; }
  .header-title { font-size: 34px; }
  .content { padding: 28px 16px 40px; }
  .about { grid-template-columns: 1fr; }
  .ch-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div class="header">
  <div class="header-brand">Skeleton Inc. · 2026 / 07 · v3 world-class rebuild</div>
  <div class="header-title">三崎屋電工<span>AI</span></div>
  <div class="header-sub">技術継承 クラウド · 提案動画 (世界標準リビルド版)</div>
  <div class="header-meta">
    <span class="meta-badge highlight">3:53 · 8章 · v3.3</span>
    <span class="meta-badge">Chirp3-HD Charon</span>
    <span class="meta-badge">Zen Kaku Gothic New 900</span>
    <span class="meta-badge">Cinema Grade 21:9 letterbox</span>
    <span class="meta-badge">-14 LUFS sidechain duck</span>
  </div>
</div>

<div class="content">

  <div class="video-wrap">
    <video id="mainVideo" controls preload="metadata">
      <source src="./demo-narration-v3.mp4?v=1784008441" type="video/mp4">
      お使いのブラウザは動画再生に対応していません。
    </video>
  </div>

  <div class="chapters">
    <div class="ch-title-row">
      <span class="ch-count">CHAPTERS</span>
      <span class="ch-title">章別ナビゲーション</span>
      <span class="rule"></span>
    </div>
    <div class="ch-grid" id="chapterGrid"></div>
  </div>

  <div class="about">
    <div class="about-card">
      <div class="about-card-h">v3 で 変わった 点</div>
      <ul>
        <li>ナレーション: Google Chirp3-HD Charon (成熟男声) + micro-segment 方式</li>
        <li>BGM: Kevin MacLeod "Inspired" + sidechain duck</li>
        <li>SFX: whoosh / impact / riser 3レイヤ (発話区切り + WOW 演出)</li>
        <li>タイポ: Zen Kaku Gothic New 900 + Inter Tight Black tabular-nums</li>
        <li>キネティック: count-up / 章 whip pan / hero reveal / Before-After</li>
        <li>撮影: 1920×1080 Playwright headless → 21:9 letterbox 130px 黒帯</li>
        <li>グレード: vignette + film grain + subtle contrast/sat</li>
        <li>Loudness: -14 LUFS 2-pass loudnorm (YouTube デファクト)</li>
      </ul>
    </div>
    <div class="about-card">
      <div class="about-card-h">章構成</div>
      <ul>
        <li>Ch01 Hook: 「技術は 消える」 の 危機感 で 開幕</li>
        <li>Ch02 Problem: 3つの 課題 を count 演出</li>
        <li>Ch03 Reveal: 三崎屋電工AI hero shot</li>
        <li>Ch04 Feature #1: 手順書 の 閲覧</li>
        <li>Ch05 Feature #2: 動画 → 30秒 で 手順書 (山場)</li>
        <li>Ch06 Feature #3: 教材モード 3コース</li>
        <li>Ch07 ROI: 3日→30秒、6ヶ月→2週間</li>
        <li>Ch08 CTA: QR + 電話 + まとめ</li>
      </ul>
    </div>
  </div>

  <div class="credits">
    <b>Music</b> — "Inspired" by Kevin MacLeod (incompetech.com) · Licensed under Creative Commons: By Attribution 4.0 License (creativecommons.org/licenses/by/4.0)<br>
    <b>Voice</b> — Google Cloud Text-to-Speech · ja-JP-Chirp3-HD-Charon
  </div>

</div>

<div class="footer">
  三崎屋電工AI · Skeleton Inc. · 2026 · v3
</div>

<script>
const chapters = [
  { name: 'イントロ · 課題の重み',       t:   0.00, dur: 21.7, num: '01' },
  { name: '3つの 課題',                  t:  21.70, dur: 26.0, num: '02' },
  { name: '三崎屋電工AI · 解決',         t:  47.70, dur: 16.9, num: '03' },
  { name: '手順書を 開く',                t:  64.58, dur: 32.8, num: '04' },
  { name: '動画から 30秒 で 手順書',      t:  97.36, dur: 62.4, num: '05' },
  { name: '若手育成 · 教材モード',        t: 159.77, dur: 22.0, num: '06' },
  { name: 'Before / After · ROI',       t: 181.75, dur: 20.5, num: '07' },
  { name: 'CTA · デモ環境',              t: 202.20, dur: 28.3, num: '08' },
];

const video = document.getElementById('mainVideo');
const grid  = document.getElementById('chapterGrid');

chapters.forEach((ch, i) => {
  const btn = document.createElement('button');
  btn.className = 'ch-btn';
  btn.innerHTML = `
    <div class="ch-num">${ch.num}</div>
    <div class="ch-info">
      <div class="ch-name">${ch.name}</div>
      <div class="ch-dur">${fmt(ch.t)} — ${ch.dur.toFixed(0)}秒</div>
    </div>`;
  btn.addEventListener('click', () => {
    video.currentTime = ch.t;
    video.play();
    document.querySelectorAll('.ch-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
  grid.appendChild(btn);
});

video.addEventListener('timeupdate', () => {
  const t = video.currentTime;
  let active = -1;
  chapters.forEach((ch, i) => { if (t >= ch.t && t < ch.t + ch.dur) active = i; });
  document.querySelectorAll('.ch-btn').forEach((b, i) => b.classList.toggle('active', i === active));
});

function fmt(sec) {
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return `${m}:${String(s).padStart(2,'0')}`;
}
</script>
</body>
</html>
